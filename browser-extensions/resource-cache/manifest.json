


        {
          
              "manifest_version"            : 3,
              "name"                        : "cache",
              "version"                     : "1.0",
              "permissions"                 : ["declarativeNetRequest","declarativeNetRequestFeedback","scripting","activeTab"],
              "host_permissions"            : ["<all_urls>"],
              "background"                  : {
                                                    "service_worker":"extension.js",
                                                    "scripts": ["extension.js"]
                                              },
              "icons"                       : {"48":"icon.png"},
              "action"                      : {"default_title":"Open Dashboard"},
              "content_scripts"             : [
                                                {
                                                      "run_at":"document_start",
                                                      "matches":[
                                                            "https://localhost/html/resource-cache.html",
                                                            "https://127.0.0.1/html/resource-cache.html",
                                                            "https://resource-cache.dev/html/resource-cache.html"
                                                      ],
                                                      "js":["content-script.js"]
                                                }
                                              ]
  
        }